+import { createServer } from 'node:http'
+import { once } from 'node:events'
+import test from 'node:test'
+import { installDshAgenticReplayTransport } from '../../../src/dsh/agenticreplay-transport.js'
+import { withFetchCaptureScope, type FetchCaptureEvent } from '@agenticreplay/node-instrument'
+
+test('native transport refuses a second process-global sink instead of claiming capture', async () => {
+  const dispose = installDshAgenticReplayTransport({ transportEvent: () => undefined, transportSinkError: () => undefined })
+  try {
+    assert.throws(() => installDshAgenticReplayTransport({ transportEvent: () => undefined, transportSinkError: () => undefined }), /already installed.*one process-global sink/u)
+  } finally { await dispose() }
+})
+
+test('native transport observes the serialized request and streamed response at the fetch boundary', async () => {
+  const requests: { method?: string; body: string }[] = []
+  const server = createServer((request, response) => {
+    const chunks: Buffer[] = []
+    request.on('data', chunk => chunks.push(Buffer.from(chunk)))
+    request.on('end', () => {
+      requests.push({ ...(request.method === undefined ? {} : { method: request.method }), body: Buffer.concat(chunks).toString('utf8') })
+      response.writeHead(200, { 'content-type': 'text/event-stream' })
+      response.write('data: {"delta":"visible"}\n\n')
+      response.end('data: [DONE]\n\n')
+    })
+  })
+  server.listen(0, '127.0.0.1')
+  await once(server, 'listening')
+  const address = server.address()
+  assert.ok(address && typeof address !== 'string')
+  const events: FetchCaptureEvent[] = []
+  const dispose = installDshAgenticReplayTransport({
+    transportEvent: event => { events.push(event) },
+    transportSinkError: error => { throw error },
+  })
+  try {
+    const url = `http://127.0.0.1:${address.port}/v1/responses`
+    const response = await withFetchCaptureScope(
+      { sessionId: 'session-native', modelCallId: 'call-native', provider: 'fixture', model: 'fixture-model' },
+      () => fetch(url, { method: 'POST', body: JSON.stringify({ system: 'IDENTIFIABLE_SYSTEM', tools: [{ name: 'tool' }], input: 'IDENTIFIABLE_INPUT' }) }),
+    )
+    const body = await response.text()
+    assert.match(body, /\[DONE\]/)
+  } finally {
+    await dispose()
+    server.close()
+    await once(server, 'close')
+  }
+  assert.equal(requests.length, 1)
+  assert.equal(requests[0]?.method, 'POST')
+  assert.match(requests[0]?.body ?? '', /IDENTIFIABLE_SYSTEM/)
+  const start = events.find(event => event.kind === 'request-start')
+  const requestBody = events.find(event => event.kind === 'request-body')
+  const response = events.find(event => event.kind === 'response')
+  assert.equal(start?.scope?.sessionId, 'session-native')
+  assert.equal(start?.scope?.modelCallId, 'call-native')
+  assert.equal(requestBody?.kind, 'request-body')
+  assert.match(requestBody?.body ?? '', /IDENTIFIABLE_INPUT/)
+  assert.equal(response?.kind, 'response')
+  assert.match(response?.body ?? '', /\[DONE\]/)
+  assert.equal(response?.terminalOutcome, 'completed')
+})
+
