{
  "name": "agenticreplay",
  "version": "0.1.8",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "check": "npm run fmt:check && npm run typecheck && npm run test",
    "prepack": "npm run build && node scripts/publish-order.mjs --quiet",
    "version": "node scripts/npm-version.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "description": "Record and inspect AI agent API traffic and activity",
  "mcpName": "io.github.askdkc/agenticreplay",
  "keywords": [
    "ai",
    "agent",
    "debugger",
    "record",
    "llm",
    "observability",
    "claude",
    "openai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/askdkc/AgenticReplay.git"
  },
  "main": "./packages/cli/dist/index.js",
  "types": "./packages/cli/dist/index.d.ts",
  "bin": {
    "agenticreplay": "bin/agenticreplay.js"
  },
  "exports": {
    ".": "./packages/cli/dist/index.js"
  },
  "files": [
    "bin",
    "packages/cli/dist",
    "packages/cli/package.json",
    "packages/cli/quickstart"
  ],
  "bundleDependencies": true,
  "dependencies": {
    "@agenticreplay/adapters": "0.1.8",
    "@agenticreplay/core": "0.1.8",
    "@agenticreplay/fs-capture": "0.1.8",
    "@agenticreplay/mcp-shim": "0.1.8",
    "@agenticreplay/node-instrument": "0.1.8",
    "@agenticreplay/plugin-api": "0.1.8",
    "@agenticreplay/providers": "0.1.8",
    "@agenticreplay/proxy": "0.1.8",
    "@agenticreplay/schema": "0.1.8",
    "@agenticreplay/shell-shim": "0.1.8",
    "@agenticreplay/viewer": "0.1.8"
  }
}
