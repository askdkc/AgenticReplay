{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Continuum-AI-Corp/agenticreplay",
  "description": "Record, inspect and export AI agent API traffic and activity logs.",
  "repository": {
    "url": "https://github.com/askdkc/AgenticReplay",
    "source": "github"
  },
  "version": "0.2.2",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "agenticreplay",
      "version": "0.2.2",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "isRequired": true,
          "description": "Serves the AgenticReplay recording-inspection tools over stdio."
        }
      ]
    }
  ]
}
